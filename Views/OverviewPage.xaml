<Page
    x:Class="CodexDreamSkinManager.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">

            <StackPanel Spacing="6">
                <TextBlock Text="当前主题" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                <TextBlock x:Name="OverviewThemeNameText" Text="读取中…" Style="{StaticResource TitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="StartButton" Content="启动皮肤" Click="OnStartClick" />
                    <Button x:Name="EditThemeButton" Content="编辑主题" Click="OnEditThemeClick" />
                    <Button x:Name="OpenActionsButton" Content="打开操作" Click="OnOpenActionsClick" />
                </StackPanel>
            </StackPanel>

            <Grid>
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                    <TextBlock x:Name="PreviewPlaceholder" Text="未加载背景" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Grid>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
