<Page
    x:Class="CodexDreamSkinManager.Views.ThemesPage"
    x:Name="root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16" RowSpacing="12">

        <!-- ===== 视图一：主题库（默认展示）===== -->
        <Grid x:Name="LibraryView" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="主题库" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="点击主题进入编辑 · 拖拽可排序" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" VerticalAlignment="Center" />
                <Button Grid.Column="3" x:Name="NewButton" Content="新建" Click="OnNewClick" />
                <Button Grid.Column="4" x:Name="EditActiveButton" Content="编辑当前" Click="OnEditActiveClick" />
                <Button Grid.Column="5" x:Name="HiddenButton" Content="隐藏主题" Click="OnHiddenClick" />
                <Button Grid.Column="6" x:Name="SmallSizeButton" Content="小" Click="OnSmallSizeClick" FontSize="12" Padding="8,4" />
                <Button Grid.Column="7" x:Name="LargeSizeButton" Content="大" Click="OnLargeSizeClick" FontSize="12" Padding="8,4" />
            </Grid>

            <GridView
                Grid.Row="1"
                x:Name="ThemesGrid"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                CanReorderItems="True"
                AllowDrop="True"
                ItemClick="OnThemeItemClick">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="{Binding ElementName=root, Path=CardWidth}" Spacing="6" Padding="8">
                            <!-- 缩略图 -->
                            <Grid Height="{Binding ElementName=root, Path=CardHeight}">
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                <Border Background="#88000000" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{Binding AppliedBadgeVisibility}">
                                    <TextBlock Text="当前" FontSize="11" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextAlignment="Center" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <Button Content="应用" Tag="{Binding Directory}" Click="OnApplyThemeClick" FontSize="12" Padding="10,4" IsEnabled="{Binding IsApplied, Converter={StaticResource InverseBoolConverter}}" />
                                <Button Content="隐藏" Tag="{Binding Directory}" Click="OnHideThemeClick" FontSize="12" Padding="10,4" />
                                <Button Content="删除" Tag="{Binding Directory}" Click="OnDeleteThemeClick" FontSize="12" Padding="10,4" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>

        <!-- ===== 视图二：主题编辑（点击主题后展示）===== -->
        <ScrollViewer x:Name="EditorView" Visibility="Collapsed">
            <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="BackButton" Content="← 返回主题库" Click="OnBackClick" />
                    <TextBlock x:Name="EditorSourceText" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>

                <Grid Height="200">
                    <Grid>
                        <Image x:Name="EditorPreview" Stretch="Uniform" />
                        <TextBlock x:Name="EditorPreviewPlaceholder" Text="未加载背景" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                    </Grid>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ChooseImageButton" Content="更换背景" Click="OnChooseImageClick" />
                    <Button x:Name="SaveButton" Content="保存" Click="OnSaveClick" />
                    <Button x:Name="SaveCopyButton" Content="另存主题" Click="OnSaveCopyClick" />
                    <Button x:Name="DeleteButton" Content="删除主题" Click="OnDeleteClick" />
                    <Button x:Name="HideEditorButton" Content="隐藏主题" Click="OnHideEditorClick" />
                </StackPanel>

                <Grid ColumnSpacing="12" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="EditName" MaxLength="80" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="副标题" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="EditBrandSubtitle" MaxLength="120" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="标语" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="EditTagline" MaxLength="180" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="项目前缀" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="EditProjectPrefix" MaxLength="120" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="项目标签" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="EditProjectLabel" MaxLength="120" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="状态文案" VerticalAlignment="Center" />
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="EditStatusText" MaxLength="120" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="引用文案" VerticalAlignment="Center" />
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="EditQuote" MaxLength="120" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="外观" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="7" Grid.Column="1" x:Name="EditAppearance">
                        <ComboBoxItem Content="auto" />
                        <ComboBoxItem Content="light" />
                        <ComboBoxItem Content="dark" />
                    </ComboBox>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="安全区" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="8" Grid.Column="1" x:Name="EditSafeArea">
                        <ComboBoxItem Content="auto" />
                        <ComboBoxItem Content="left" />
                        <ComboBoxItem Content="center" />
                        <ComboBoxItem Content="right" />
                        <ComboBoxItem Content="none" />
                    </ComboBox>

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="任务页" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="9" Grid.Column="1" x:Name="EditTaskMode">
                        <ComboBoxItem Content="auto" />
                        <ComboBoxItem Content="ambient" />
                        <ComboBoxItem Content="banner" />
                        <ComboBoxItem Content="off" />
                    </ComboBox>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="任务页背景" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Slider x:Name="EditTaskOpacity" Minimum="0" Maximum="1" StepFrequency="0.01" Width="220" ValueChanged="OnRangeValueChanged" />
                        <TextBlock x:Name="TaskOpacityValue" Text="18%" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Row="11" Grid.Column="0" Text="主页背景" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Slider x:Name="EditHomeOpacity" Minimum="0" Maximum="1" StepFrequency="0.01" Width="220" ValueChanged="OnRangeValueChanged" />
                        <TextBlock x:Name="HomeOpacityValue" Text="93%" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Row="12" Grid.Column="0" Text="强调色" VerticalAlignment="Center" />
                    <TextBox Grid.Row="12" Grid.Column="1" x:Name="EditAccent" PlaceholderText="#287a78" />

                    <TextBlock Grid.Row="13" Grid.Column="0" Text="焦点 X" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="13" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Slider x:Name="EditFocusX" Minimum="0" Maximum="1" StepFrequency="0.01" Width="220" ValueChanged="OnRangeValueChanged" />
                        <TextBlock x:Name="FocusXValue" Text="0.50" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Row="14" Grid.Column="0" Text="焦点 Y" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="14" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Slider x:Name="EditFocusY" Minimum="0" Maximum="1" StepFrequency="0.01" Width="220" ValueChanged="OnRangeValueChanged" />
                        <TextBlock x:Name="FocusYValue" Text="0.50" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <TextBox
                    x:Name="OutputBox"
                    IsReadOnly="True"
                    TextWrapping="Wrap"
                    AcceptsReturn="True"
                    MinHeight="70"
                    FontFamily="Consolas"
                    FontSize="12"
                    PlaceholderText="等待操作。"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>

        <!-- ===== 视图三：隐藏主题列表 ===== -->
        <Grid x:Name="HiddenView" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                <Button Content="← 返回主题库" Click="OnBackClick" />
                <TextBlock Text="隐藏主题" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <GridView Grid.Row="1" x:Name="HiddenThemesGrid" SelectionMode="None" IsItemClickEnabled="False">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="{Binding ElementName=root, Path=CardWidth}" Spacing="6" Padding="8">
                            <Grid Height="{Binding ElementName=root, Path=CardHeight}">
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                <Border Background="#88000000" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{Binding AppliedBadgeVisibility}">
                                    <TextBlock Text="当前" FontSize="11" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextAlignment="Center" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <Button Content="取消隐藏" Tag="{Binding Directory}" Click="OnUnhideThemeClick" FontSize="12" Padding="10,4" />
                                <Button Content="删除" Tag="{Binding Directory}" Click="OnDeleteThemeClick" FontSize="12" Padding="10,4" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
